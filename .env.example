# Frontend needs no environment variables. Public defaults: src/config/appConfig.js.
# Configure production in Hostinger's SERVER environment; never commit secrets.
# See MYSQL_SETUP.md for Node.js deployment (not static-only dist hosting).

# Hostinger production:
# NODE_ENV=production
# STORE_MODE=live
# DATABASE_DRIVER=mysql
# DB_HOST=YOUR_HOSTINGER_DATABASE_HOST
# DB_PORT=3306
# DB_USER=YOUR_HOSTINGER_DATABASE_USER
# DB_PASSWORD=YOUR_DATABASE_PASSWORD
# DB_NAME=YOUR_HOSTINGER_DATABASE_NAME
# PUBLIC_STORE_URL=https://www.membraneiq.com
# FIREBASE_PROJECT_ID=membrane-7677f
# FIREBASE_SERVICE_ACCOUNT=COMPLETE_UNMODIFIED_DOWNLOADED_SERVICE_ACCOUNT_JSON
# Alternative private service-account JSON file accessible to the server:
# GOOGLE_APPLICATION_CREDENTIALS=/private/path/service-account.json

# URL alternative to DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME.
# Use one style; percent-encode passwords inside URLs.
# MYSQL_URL=mysql://USER:URL_ENCODED_PASSWORD@HOST:3306/DATABASE
# DATABASE_URL=mysql://USER:URL_ENCODED_PASSWORD@HOST:3306/DATABASE

# TLS when required by the database provider; verification stays enabled.
# DB_SSL=true
# DB_SSL_CA=PEM_CA_CERTIFICATE_CONTENTS
# Exact trusted proxy IPs/CIDRs only if confirmed by Hostinger; otherwise omit.
# TRUST_PROXY=CONFIRMED_PROXY_IP_OR_CIDR
# PORT is normally supplied by the host; local API defaults to 8787.

# Cashfree stays disabled until explicitly integrated and tested server-side.
# Real refunds/reconciliation are pending; see PAYMENT_RULES.md.
# CASHFREE_MODE=sandbox
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_API_VERSION=2025-01-01

# LOCAL ONLY: use these instead of the production connection fields above.
# STORE_MODE=emulator
# DATABASE_DRIVER=mysql
# MYSQL_PASSWORD=choose-a-local-password
# MYSQL_ROOT_PASSWORD=choose-a-different-root-password
# MYSQL_URL=mysql://membrane:URL_ENCODED_LOCAL_PASSWORD@127.0.0.1:3307/membrane_store
