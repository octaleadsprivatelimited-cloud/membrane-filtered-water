# Local emulator defaults. Never expose server keys with a VITE_ prefix.
STORE_MODE=emulator
FIREBASE_PROJECT_ID=demo-aquapure-store
VITE_USE_FIREBASE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-aquapure-store
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-aquapure-store.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
# Live: STORE_MODE=live, VITE_USE_FIREBASE_EMULATORS=false and your web app config.
# Authenticate server through Application Default Credentials / managed identity.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# PUBLIC_STORE_URL=https://your-domain.example
CASHFREE_MODE=disabled
# CASHFREE_MODE=sandbox or production
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# CASHFREE_API_VERSION=2025-01-01
PORT=8787
