# Frontend needs no environment variables. Public defaults: src/config/appConfig.js.
# localhost uses emulators; Vercel uses live Firebase automatically.
# Production server credential (complete downloaded service-account JSON):
# FIREBASE_SERVICE_ACCOUNT=
# Local live-server alternative: GOOGLE_APPLICATION_CREDENTIALS=/private/path/key.json
# Backend-only overrides, optional:
# STORE_MODE=live
# FIREBASE_PROJECT_ID=membrane-7677f
# PUBLIC_STORE_URL=https://www.membraneiq.com
# Cashfree remains disabled until explicitly connected server-side:
# CASHFREE_MODE=sandbox
# CASHFREE_CLIENT_ID=
# CASHFREE_CLIENT_SECRET=
# PORT=8787
